# Zkopíruj jako .env a doplň vlastní hodnoty. .env nikdy necommituj.
OPENROUTER_API_KEY=
# Klíče pro REST API (hlavička X-API-Key), víc klíčů odděl čárkou. Vymysli vlastní dlouhý řetězec.
RAG_API_KEYS=
# 1 = jen uložené výsledky, nikdy placené volání. 0 = živé dotazy přes OpenRouter (stojí peníze).
# docker compose bere prázdnou hodnotu jako 1 (offline). Mimo Docker je offline jen při RAG_OFFLINE=1.
RAG_OFFLINE=
